# Django Core Settings
SECRET_KEY=replace-with-a-secure-50-character-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,gshoptest.uz,www.gshoptest.uz
CSRF_TRUSTED_ORIGINS=https://gshoptest.uz,https://www.gshoptest.uz

# Database Configuration (sqlite3 or postgresql)
DB_ENGINE=postgresql
DB_NAME=shop_pc_prod
DB_USER=shop_pc_user
DB_PASSWORD=replace-with-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Security & HTTPS
ENABLE_HTTPS=True
SECURE_SSL_REDIRECT=True

# Email Configuration (Password Recovery & Notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@gshoptest.uz
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=PC Shop <noreply@gshoptest.uz>

